# .env.production — copy to .env (gitignored) and fill in real values.
# Generate strong secrets: python -c "import secrets; print(secrets.token_urlsafe(32))"

# App
APP_NAME=EthioSci AI Assistant
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=GENERATE_WITH_secrets_token_urlsafe_32

# Database — Railway PostgreSQL plugin (auto-injects DATABASE_URL)
DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:PORT/DB
DATABASE_SYNC_URL=postgresql://USER:PASS@HOST:PORT/DB

# Redis — Upstash free tier (rediss:// for TLS)
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379

# Telegram
TELEGRAM_BOT_TOKEN=BOTFATHER_TOKEN

# Ollama Cloud — https://ollama.com (free: 1 concurrent, 5h session / 7d weekly)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_CHAT_MODEL=glm-5.2  # or deepseek-v4-flash, qwen3.5, kimi-k2.6
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_API_KEY=KEY_FROM_OLLAMA_SETTINGS

# Vector Store (Stage 2: will move to pgvector)
VECTOR_STORE_PATH=./data/vectors
# Kept as "ethiobio_curriculum": matches the live Render environment / existing vector data
COLLECTION_NAME=ethiobio_curriculum

# Observability
# Kept as "ethiobio": matches the live Render environment
OTEL_SERVICE_NAME=ethiobio
# Kept as "ethiobio": LangSmith project continuity (existing traces/datasets live there)
LANGSMITH_PROJECT=ethiobio
SENTRY_DSN=SENTRY_PROJECT_DSN

# Dashboard
DASHBOARD_URL=https://DASHBOARD.vercel.app
API_BASE_URL=https://API.up.railway.app
JWT_SECRET=GENERATE_WITH_secrets_token_urlsafe_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
