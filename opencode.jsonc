{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ["/home/tcyber/.config/opencode/plugins/goal-plugin.js", { "evaluator": true }]
  ],
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "build"
    }
  }
}
