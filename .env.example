# App
APP_NAME=EthioBio AI Assistant
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql+asyncpg://ethiobio:ethiobio_pass@localhost:5432/ethiobio
DATABASE_SYNC_URL=postgresql://ethiobio:ethiobio_pass@localhost:5432/ethiobio

# Redis (local: docker-compose; production: Upstash free tier)
REDIS_URL=redis://localhost:6379/0
# For Upstash, use: rediss://default:PASSWORD@HOST.upstash.io:6379

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Ollama (Primary LLM)
# Local:   OLLAMA_BASE_URL=http://localhost:11434 (no key needed)
# Cloud:   OLLAMA_BASE_URL=https://ollama.com + OLLAMA_API_KEY=<key from ollama.com/settings/keys>
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_API_KEY=  # Required only when OLLAMA_BASE_URL is https://ollama.com

# OpenRouter (Optional — provides wider model selection)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_DEFAULT_MODEL=openai/gpt-4o

# Fallback Provider (Optional)
# Set to "openai" or "anthropic"
FALLBACK_PROVIDER=openai
FALLBACK_API_KEY=sk-...
FALLBACK_MODEL=gpt-4o-mini

# Additional OpenAI-Compatible Provider (LM Studio, vLLM, etc.)
# PROVIDER_OPENAI_COMPATIBLE_NAME=lm-studio
# PROVIDER_OPENAI_COMPATIBLE_URL=http://localhost:1234/v1
# PROVIDER_OPENAI_COMPATIBLE_API_KEY=not-needed
# PROVIDER_OPENAI_COMPATIBLE_MODEL=local-model

# Vector Store
VECTOR_STORE_PATH=./data/vectors
COLLECTION_NAME=ethiobio_curriculum

# Whisper (Voice)
WHISPER_MODEL=base

# OpenTelemetry
# OTel traces/metrics export endpoint (gRPC). Leave unset for in-memory only.
# When running Docker Compose with Jaeger: set to http://jaeger:4317
# OTEL_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=ethiobio

# Sentry (Free tier — https://sentry.io)
# Create a project at https://sentry.io, copy the DSN here for production.
# Left unset, Sentry stays disabled.
# SENTRY_DSN=https://your-key@sentry.io/1

# Dashboard
DASHBOARD_URL=http://localhost:3000
API_BASE_URL=http://app:8000
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL
PG_PASSWORD=change-me-pg-password
PG_USER=ethiobio
PG_DB=ethiobio

# Grafana
GRAFANA_PASSWORD=change-me-grafana-password
GRAFANA_USER=admin

# Ollama version
OLLAMA_VERSION=0.5.12

# Internal API key (inter-service auth)
# INTERNAL_API_KEY=change-me-internal-key

# Cloudflare (image generation)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Email (notifications)
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_FROM=noreply@ethiobio.com

# Guardrail toggles (all enabled by default)
# RATE_LIMIT_ENABLED=true
# INPUT_SANITIZE_ENABLED=true
# PROMPT_INJECTION_ENABLED=true
# OUTPUT_TOXICITY_ENABLED=true
# OUTPUT_PII_DETECTION_ENABLED=true
# OUTPUT_TOPIC_ENFORCEMENT_ENABLED=true
# TOOL_GUARD_ENABLED=true
# DRIFT_MONITOR_ENABLED=true

# Observability
# OTEL_ENDPOINT=http://jaeger:4317
# OTEL_TRACES_SAMPLING_RATE=1.0
# SENTRY_DSN=

# Eval
# EVAL_ENABLED=true
# EVAL_SAMPLING_RATE=0.15
# EVAL_JUDGE_MODEL=gpt-4o-mini

