# App
APP_NAME=EthioBio AI Assistant
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=change-me

# Database
DATABASE_URL=postgresql+asyncpg://ethiobio:ethiobio_pass@localhost:5432/ethiobio
DATABASE_SYNC_URL=postgresql://ethiobio:ethiobio_pass@localhost:5432/ethiobio

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Ollama (Primary LLM)
# Local:   OLLAMA_BASE_URL=http://localhost:11434 (no key needed)
# Cloud:   OLLAMA_BASE_URL=http://localhost:11434 + OLLAMA_API_KEY=<key from ollama.com/settings/keys>
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=tinyllama
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_API_KEY=

# OpenRouter (Optional — provides wider model selection)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o

# Fallback Provider (Optional)
# Set to "openai" or "anthropic"
FALLBACK_PROVIDER=openai
FALLBACK_API_KEY=sk-...
FALLBACK_MODEL=gpt-4o-mini

# Additional OpenAI-Compatible Provider (LM Studio, vLLM, etc.)
PROVIDER_OPENAI_COMPATIBLE_NAME=
PROVIDER_OPENAI_COMPATIBLE_URL=
PROVIDER_OPENAI_COMPATIBLE_API_KEY=
PROVIDER_OPENAI_COMPATIBLE_MODEL=

# Vector Store
VECTOR_STORE_PATH=./data/vectors_new
COLLECTION_NAME=ethiobio_curriculum
STORE_BACKEND=pgvector
# Set false on memory-limited hosts (e.g. Railway 1GB) to skip the cross-encoder reranker
ENABLE_RERANKER=true

# Whisper / Voice
GEMINI_API_KEY=
GROQ_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
EDGE_TTS_EN_VOICE=en-US-AriaNeural
EDGE_TTS_AM_VOICE=am-ET-AmehaNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_VOLUME=+0%
WHISPER_MODEL=base
TELEGRAM_VOICE_MAX_SIZE=20971520
AUDIO_STORAGE_PATH=./data/audio_recordings
AUDIO_RETENTION_DAYS=90

# Feature flag: single-tap voice conversation (Phase 2)
VOICE_TURN_ENABLED=false

# Dashboard / API
DASHBOARD_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Cloudflare (image generation)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Email (notifications)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@ethiobio.com
EMAIL_USE_TLS=true

# JWT
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal API key (inter-service auth)
INTERNAL_API_KEY=

# Guardrail toggles
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USER_MAX=60
RATE_LIMIT_USER_WINDOW=60
RATE_LIMIT_IP_MAX=120
RATE_LIMIT_IP_WINDOW=60
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_GLOBAL_WINDOW=60
INPUT_SANITIZE_ENABLED=true
INPUT_MAX_LENGTH=2000
PROMPT_INJECTION_ENABLED=true
PROMPT_INJECTION_THRESHOLD=0.7
OUTPUT_TOXICITY_ENABLED=true
OUTPUT_PII_DETECTION_ENABLED=true
OUTPUT_TOPIC_ENFORCEMENT_ENABLED=true
TOOL_GUARD_ENABLED=true
DRIFT_MONITOR_ENABLED=true
DRIFT_MONITOR_WINDOW=1000
DRIFT_ALERT_THRESHOLD=0.05

# OpenTelemetry
OTEL_SERVICE_NAME=ethiobio
OTEL_ENDPOINT=
OTEL_TRACES_SAMPLING_RATE=1.0

# Sentry (Free tier — https://sentry.io)
SENTRY_DSN=

# Observability
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_HEALTH_ENABLED=true
OBSERVABILITY_ALERTING_ENABLED=true

# Eval
EVAL_ENABLED=true
EVAL_SAMPLING_RATE=0.15
EVAL_JUDGE_MODEL=gpt-4o-mini
EVAL_DRIFT_THRESHOLD=0.10

# Docker Compose only
PG_PASSWORD=change-me-pg-password
PG_USER=ethiobio
PG_DB=ethiobio
GRAFANA_PASSWORD=change-me-grafana-password
GRAFANA_USER=admin
OLLAMA_VERSION=0.5.12
